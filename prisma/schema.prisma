generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Clerk user profile — stores only app-specific data.
/// Clerk manages authentication (email, password, sessions).
/// clerkId matches the Clerk user ID (format: "user_xxxx").
model UserProfile {
  clerkId        String         @id
  monthlyIncome  Int?
  statements     Statement[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  monthCloses    MonthClose[]
  merchantRules  MerchantRule[]
}

model Statement {
  id           String        @id @default(uuid())
  userId       String
  bank         String
  month        String
  fileName     String
  s3Key        String
  s3Url        String
  status       String        @default("pending")
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         UserProfile   @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  transactions Transaction[]
}

model Category {
  id            String         @id @default(uuid())
  userId        String
  name          String
  color         String
  icon          String?
  type          String?
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          UserProfile    @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]
  merchantRules MerchantRule[]

  @@unique([userId, name])
}

model Budget {
  id            String      @id @default(uuid())
  userId        String
  categoryId    String
  month         String      // "YYYY-MM" e.g. "2026-04"
  monthlyAmount Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          UserProfile @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
}

model MonthClose {
  id            String      @id @default(uuid())
  userId        String
  month         String      // "YYYY-MM"
  totalSpent    Float
  totalBudget   Float
  summary       Json        // CategorySummary[]
  aiSuggestions String
  notes         String?
  closedAt      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          UserProfile @relation(fields: [userId], references: [clerkId], onDelete: Cascade)

  @@unique([userId, month])
}

model Transaction {
  id               String      @id @default(uuid())
  userId           String
  statementId      String?
  categoryId       String
  date             DateTime
  description      String
  merchant         String
  amount           Float
  currency         String      @default("CLP")
  isInstallment    Boolean     @default(false)
  installmentNum   Int?
  installmentTotal Int?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             UserProfile @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  statement        Statement?  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  category         Category    @relation(fields: [categoryId], references: [id])
}

model MerchantRule {
  id              String      @id @default(uuid())
  userId          String
  merchantPattern String      // normalized (lowercase, trimmed) merchant name
  categoryId      String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            UserProfile @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantPattern])
}
