generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Clerk user profile — stores only app-specific data.
/// Clerk manages authentication (email, password, sessions).
/// clerkId matches the Clerk user ID (format: "user_xxxx").
model UserProfile {
  clerkId        String         @id
  monthlyIncome  Int?
  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]
  merchantRules   MerchantRule[]
  trackingUploads TrackingUpload[]
}

model Category {
  id            String         @id @default(uuid())
  userId        String
  name          String
  color         String
  icon          String?
  type          String?
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          UserProfile    @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]
  merchantRules MerchantRule[]

  @@unique([userId, name])
}

model Budget {
  id            String      @id @default(uuid())
  userId        String
  categoryId    String
  month         String      // "YYYY-MM" e.g. "2026-04"
  monthlyAmount Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          UserProfile @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
}

model TrackingUpload {
  id           String        @id @default(uuid())
  userId       String
  bank         String
  accountType  String        // 'checking' | 'credit_card'
  month        String        // YYYY-MM (accountingMonth)
  rowCount     Int
  uploadedAt   DateTime      @default(now())
  user         UserProfile   @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, month])
}

model Transaction {
  id               String          @id @default(uuid())
  userId           String
  categoryId       String
  date             DateTime
  description      String
  merchant         String
  amount           Float
  currency         String          @default("CLP")
  bank             String          @default("") // 'santander' | 'falabella' | ... — '' = unknown/manual
  accountType      String          @default("") // 'checking' | 'credit_card' | '' — populated for origin='tracking'
  isInstallment    Boolean         @default(false)
  installmentNum   Int?
  installmentTotal Int?
  notes            String?
  reviewStatus     String          @default("pending")  // 'pending' | 'auto' | 'confirmed' | 'manual'
  transactionType  String          @default("expense")   // 'expense' | 'income' | 'transfer'
  origin           String          @default("manual")    // 'tracking' | 'manual'
  accountingMonth  String          @default("")           // 'YYYY-MM' — period this tx is counted in; '' = use date
  trackingUploadId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             UserProfile     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  category         Category        @relation(fields: [categoryId], references: [id])
  trackingUpload   TrackingUpload? @relation(fields: [trackingUploadId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, origin])
}

model MerchantRule {
  id              String      @id @default(uuid())
  userId          String
  merchantPattern String      // normalized (lowercase, trimmed) merchant name
  bank            String      @default("") // "" = any card; "santander" | "falabella" | "liderbci"
  categoryId      String
  transactionType String?     // null = auto-detect; "expense" | "income" | "transfer"
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            UserProfile @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantPattern, bank])
}

